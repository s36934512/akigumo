generator client {
    provider            = "prisma-client"
    output              = "../../src/generated/prisma"
    moduleFormat        = "esm"
    importFileExtension = "js"
}

generator zod {
    provider = "prisma-zod-generator"
    output   = "../../src/generated/zod"
}

datasource db {
    provider = "postgresql"
}
