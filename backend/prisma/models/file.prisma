model File {
    id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

    // 使用者提供的檔名
    originalName String? @map("original_name")

    // 系統儲存名稱 / 實體路徑
    systemName   String? @map("system_name")
    physicalPath String? @map("physical_path")

    // 檔案實際格式
    extensionCode String? @map("extension_code")
    mimeType      String? @map("mime_type")

    // 檔案內容資訊
    size     BigInt?
    checksum String?
    metadata Json?

    // 是否為原始檔案
    isOriginal Boolean @default(false) @map("is_original")

    // 建立此 File 的 Workflow
    createdByWorkflowId String? @map("created_by_workflow_id") @db.Uuid

    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @updatedAt @map("updated_at")
    deletedAt     DateTime? @map("deleted_at")
    lastScannedAt DateTime? @map("last_scanned_at")

    @@index([extensionCode])
    @@index([mimeType])
    @@index([checksum])
    @@index([createdByWorkflowId])
    @@map("file")
}
