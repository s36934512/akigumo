from collections.abc import Callable, Iterable, Iterator, Sequence
from datetime import datetime
from pathlib import Path
from types import TracebackType
from typing import IO, Protocol, Self, TypeAlias

# ------------------------------------------------------------------
# File-like protocols and aliases
# ------------------------------------------------------------------

class FileLike(Protocol):
    def read(self, size: int = -1, /) -> bytes: ...
    def seek(self, offset: int, whence: int = 0, /) -> int: ...
    def tell(self) -> int: ...
    def close(self) -> None: ...

PathLike: TypeAlias = str | bytes | Path
DateTuple: TypeAlias = tuple[int, int, int, int, int, int]

# ------------------------------------------------------------------
# Exceptions
# ------------------------------------------------------------------

class Error(Exception): ...
class BadRarFile(Error): ...
class NotRarFile(Error): ...
class BadRarName(Error): ...
class NoRarEntry(Error): ...
class PasswordRequired(Error): ...
class BadSymLinkError(Error): ...

class NeedFirstVolume(Error):
    current_volume: int | None

    def __init__(self, msg: str, volume: int | None) -> None: ...

class NoCrypto(Error): ...
class RarExecError(Error): ...
class RarWarning(RarExecError): ...
class RarFatalError(RarExecError): ...
class RarCRCError(RarExecError): ...
class RarLockedArchiveError(RarExecError): ...
class RarWriteError(RarExecError): ...
class RarOpenError(RarExecError): ...
class RarUserError(RarExecError): ...
class RarMemoryError(RarExecError): ...
class RarCreateError(RarExecError): ...
class RarNoFilesError(RarExecError): ...
class RarUserBreak(RarExecError): ...
class RarWrongPassword(RarExecError): ...
class RarUnknownError(RarExecError): ...
class RarSignalExit(RarExecError): ...
class RarCannotExec(RarExecError): ...
class UnsupportedWarning(UserWarning): ...

# ------------------------------------------------------------------
# RarInfo
# ------------------------------------------------------------------

class RarInfo:
    filename: str
    file_size: int
    compress_size: int | None
    compress_type: int
    extract_version: int
    host_os: int
    mode: int
    date_time: DateTuple | None

    CRC: int | None
    volume: int
    volume_file: str | bytes | Path | FileLike | None

    orig_filename: str | None
    comment: str | None

    mtime: datetime | None
    ctime: datetime | None
    atime: datetime | None
    arctime: datetime | None

    blake2sp_hash: str | None
    file_redir: tuple[int, int, str] | None

    flags: int
    type: int | None

    def is_dir(self) -> bool: ...
    def is_file(self) -> bool: ...
    def is_symlink(self) -> bool: ...
    def isdir(self) -> bool: ...
    def needs_password(self) -> bool: ...

# ------------------------------------------------------------------
# RarExtFile
# ------------------------------------------------------------------

class RarExtFile:
    name: str | None

    def read(self, size: int | None = -1) -> bytes: ...
    def readinto(self, buffer: bytearray | memoryview) -> int: ...
    def readall(self) -> bytes: ...
    def readline(self, size: int = -1) -> bytes: ...
    def readlines(self, hint: int = -1) -> list[bytes]: ...
    def seek(self, offset: int, whence: int = 0) -> int: ...
    def tell(self) -> int: ...
    def close(self) -> None: ...
    def readable(self) -> bool: ...
    def writable(self) -> bool: ...
    def seekable(self) -> bool: ...
    def fileno(self) -> int: ...
    def isatty(self) -> bool: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

# ------------------------------------------------------------------
# RarFile
# ------------------------------------------------------------------

class RarFile:
    filename: str | None
    comment: str | None

    def __init__(
        self,
        file: PathLike | FileLike,
        mode: str = "r",
        charset: str | None = None,
        info_callback: Callable[[RarInfo], None] | None = None,
        crc_check: bool = True,
        errors: str = "stop",
        part_only: bool = False,
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
    def __iter__(self) -> Iterator[RarInfo]: ...
    def setpassword(self, pwd: str | None) -> None: ...
    def needs_password(self) -> bool: ...
    def is_solid(self) -> bool: ...
    def namelist(self) -> list[str]: ...
    def infolist(self) -> Sequence[RarInfo]: ...
    def volumelist(self) -> Sequence[PathLike | FileLike]: ...
    def getinfo(self, name: str | Path | RarInfo) -> RarInfo: ...
    def getinfo_orig(self, name: str | Path | RarInfo) -> RarInfo: ...
    def open(
        self,
        name: str | Path | RarInfo,
        mode: str = "r",
        pwd: str | None = None,
    ) -> RarExtFile: ...
    def read(
        self,
        name: str | Path | RarInfo,
        pwd: str | None = None,
    ) -> bytes: ...
    def close(self) -> None: ...
    def printdir(self, file: IO[str] | None = None) -> None: ...
    def extract(
        self,
        member: str | Path | RarInfo,
        path: str | Path | None = None,
        pwd: str | None = None,
    ) -> str | None: ...
    def extractall(
        self,
        path: str | Path | None = None,
        members: Iterable[str | Path | RarInfo] | None = None,
        pwd: str | None = None,
    ) -> None: ...
    def testrar(self, pwd: str | None = None) -> None: ...
    def strerror(self) -> str | None: ...

